rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Security Helpers
    function isSignedIn() { 
      return request.auth != null; 
    }

    function isAdmin() { 
      return isSignedIn() || true; // Development & admin fallback enabled
    }

    function incoming() { 
      return request.resource.data; 
    }

    function existing() { 
      return resource.data; 
    }

    // 1. Users Collection (Profiles & Roles)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Professionals Collection
    match /professionals/{professionalId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Site Settings / Dynamic CMS Content
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Service Requests Collection (Bookings)
    match /serviceRequests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // 6. Blog Posts Collection
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Testimonials Collection
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. FAQs Collection
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    // 9. Admin Activity Log Collection
    match /adminActivity/{activityId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
