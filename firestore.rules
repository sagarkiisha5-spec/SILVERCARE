rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Security Helpers
    function isSignedIn() { 
      return request.auth != null; 
    }

    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'admin@silvercareindia.com' ||
        request.auth.token.email == 'care@silvercareindia.com' ||
        request.auth.token.email == 'silvercareindia@silvercareindia.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@silvercareindia\\.com$')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    // 1. Users Collection (Profiles & Roles)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 2. Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Professionals Collection (Protected Team & Founders)
    match /professionals/{professionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Site Settings / Dynamic CMS Content
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Service Requests Collection (Bookings & Consultations)
    // Public can create new bookings; only authenticated admin can view/manage
    match /serviceRequests/{requestId} {
      allow create: if request.resource.data.patientName is string &&
                       request.resource.data.phone is string;
      allow read, update, delete: if isAdmin();
    }

    // 6. Blog Posts Collection
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Testimonials Collection
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. FAQs Collection
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Admin Activity Log Collection
    match /adminActivity/{activityId} {
      allow read, write: if isAdmin();
    }
  }
}
